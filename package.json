{
  "name": "agentic-pm",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint --error-on-warnings . && markdownlint-cli2 && actionlint -shellcheck= -pyflakes= && zizmor --offline .github/workflows",
    "test": "node --test",
    "check": "biome format . && pnpm run lint && lychee --offline --include-fragments --hidden . && gitleaks git --redact && gitleaks git --pre-commit --staged --redact && pnpm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "markdownlint-cli2": "0.24.2"
  }
}
