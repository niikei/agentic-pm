{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Report definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "language",
    "reader",
    "question",
    "format",
    "sections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "$ref": "#/definitions/text"
    },
    "reader": {
      "$ref": "#/definitions/text"
    },
    "question": {
      "$ref": "#/definitions/text"
    },
    "language": {
      "enum": ["en", "ja"],
      "description": "Language of the generated interface. Source titles retain their original language."
    },
    "format": {
      "enum": ["html", "markdown"]
    },
    "periodDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90,
      "description": "Trailing observation window for deliveries, in 24-hour periods.",
      "default": 7
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["decisions", "changes", "work", "deliveries", "outcomes"]
      }
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}
