{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "asOf", "coverageStart", "items", "deliveries"],
  "properties": {
    "$schema": { "type": "string" },
    "project": { "$ref": "#/definitions/text" },
    "asOf": { "$ref": "#/definitions/time" },
    "coverageStart": { "$ref": "#/definitions/time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "kind",
          "updatedAt",
          "needsDecision",
          "draft",
          "decisionSince",
          "owners"
        ],
        "properties": {
          "id": { "$ref": "#/definitions/text" },
          "title": { "$ref": "#/definitions/text" },
          "url": { "$ref": "#/definitions/url" },
          "kind": { "enum": ["work", "change"] },
          "updatedAt": { "$ref": "#/definitions/time" },
          "needsDecision": { "type": "boolean" },
          "draft": { "type": "boolean" },
          "decisionSince": {
            "anyOf": [{ "$ref": "#/definitions/time" }, { "type": "null" }]
          },
          "owners": {
            "type": "array",
            "items": { "$ref": "#/definitions/text" },
            "uniqueItems": true
          }
        }
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "at"],
        "properties": {
          "id": { "$ref": "#/definitions/text" },
          "title": { "$ref": "#/definitions/text" },
          "url": { "$ref": "#/definitions/url" },
          "at": { "$ref": "#/definitions/time" }
        }
      }
    }
  },
  "definitions": {
    "text": { "type": "string", "pattern": "\\S" },
    "url": { "type": "string", "pattern": "^https://", "format": "uri" },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "format": "date-time"
    }
  }
}
