{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "markdown": {
    "analyzeEmbeds": true,
    "formatter": {
      "enabled": true
    },
    "parser": {
      "frontmatter": true
    }
  },
  "yaml": {
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true
  }
}
